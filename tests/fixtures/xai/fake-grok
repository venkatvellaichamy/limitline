#!/usr/bin/env python3
"""Stand-in for the Grok CLI in tests. Prints a prompt, and on `/usage show`
appends one `fetched credits config` line to $LIMITLINE_GROK_LOG with
$FAKE_PCT and $FAKE_TS. Counts runs in $FAKE_COUNT and records its pid and
working directory in $FAKE_PID_FILE. Stays alive until the pty is closed or it
is signalled (FAKE_STUBBORN ignores both until SIGKILL), like the real CLI."""
import json, os, signal, sys, time

if os.environ.get("FAKE_STUBBORN"):
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)

with open(os.environ["FAKE_COUNT"], "a") as h:
    h.write("start\n")
with open(os.environ["FAKE_PID_FILE"], "w") as h:
    h.write("%d %s\n" % (os.getpid(), os.getcwd()))
sys.stdout.write("grok ready\n> ")
sys.stdout.flush()
try:
    while True:
        line = sys.stdin.readline()
        if not line:
            if os.environ.get("FAKE_STUBBORN"):
                time.sleep(0.1)
                continue
            break
        if "/usage show" in line and not os.environ.get("FAKE_SILENT"):
            row = {"ts": os.environ.get("FAKE_TS", "2025-11-02T04:00:00.000Z"), "msg": "billing: fetched credits config",
                   "ctx": {"config": {"creditUsagePercent": float(os.environ.get("FAKE_PCT", "80")),
                                      "currentPeriod": {"end": "2025-11-07T05:22:35.070+00:00"}},
                           "subscriptionTier": "SuperGrok Plus"}}
            with open(os.environ["LIMITLINE_GROK_LOG"], "a") as h:
                h.write(json.dumps(row) + "\n")
            with open(os.environ["FAKE_COUNT"], "a") as h:
                h.write("usage\n")
        sys.stdout.write("> ")
        sys.stdout.flush()
except KeyboardInterrupt:
    pass
