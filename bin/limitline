to_epoch() {
  local v="$1" base epoch
  [[ -z "$v" || "$v" == "null" || "$v" == "-" ]] && return 0
  case "$v" in
    \"*\") v="${v#\"}"; v="${v%\"}" ;;
  esac
  case "$v" in
    *[!0-9.]*) ;;
    *.*)
      printf '%s' "${v%%.*}"
      return 0
      ;;
    *)
      printf '%s' "$v"
      return 0
      ;;
  esac
  base="$v"
  case "$base" in
    *.*) base="${base%%.*}" ;;
  esac
  case "$v" in
    *Z|*z) base="${base}Z" ;;
  esac
  if epoch=$(LC_ALL=C date -j -u -f "%Y-%m-%dT%H:%M:%SZ" "$base" "+%s" 2>/dev/null); then
    printf '%s' "$epoch"
    return 0
  fi
  if epoch=$(LC_ALL=C date -u -d "$v" "+%s" 2>/dev/null); then
    printf '%s' "$epoch"
    return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import sys
from datetime import datetime
s = sys.argv[1]
if s.endswith(("Z", "z")):
    s = s[:-1] + "+00:00"
print(int(datetime.fromisoformat(s).timestamp()))' "$v" 2>/dev/null || true
  fi
}

abs_label() {
  local epoch="$1" delta
  [[ -z "$epoch" ]] && return 0
  delta=$((epoch - NOW))
  if [[ "$delta" -ge 86400 ]]; then
    LC_TIME=C date -r "$epoch" "+%a %H:%M" 2>/dev/null \
      || LC_TIME=C date -d "@$epoch" "+%a %H:%M" 2>/dev/null \
      || true
  fi
}

codex_cache_file() {
  printf '%s/limitline-codex-%s.cache' "${TMPDIR:-/tmp}" "$(id -u)"
}

cache_hit=0
if [[ "$CODEX_ENABLED" -eq 1 && -z "${LIMITLINE_PHAROS_USAGE:-}" && "${LIMITLINE_NOCACHE:-}" != "1" ]]; then
  cache_file=$(codex_cache_file)
  if [[ -f "$cache_file" ]]; then
    wall=$(date +%s)
    read -r cts ok c5 c5r c7 c7r < "$cache_file" || true
    case "$cts" in
      ''|*[!0-9]*) cts=0 ;;
    esac
    if [[ $((wall - cts)) -lt 30 && $((wall - cts)) -ge 0 ]]; then
      cache_hit=1
      if [[ "$ok" == "1" ]]; then
        [[ "$c5" == "-" ]] && c5=""
        [[ "$c5r" == "-" ]] && c5r=""
        [[ "$c7" == "-" ]] && c7=""
        [[ "$c7r" == "-" ]] && c7r=""
        codex5="$c5"
        codex5_raw="$c5r"
        codex7="$c7"
        codex7_raw="$c7r"
      fi
    fi
  fi
fi

JQ_PROG='
def emit(k; v):
  if v == null or v == false then
    k
  elif (v|type) == "string" and (v|gsub("[\t\r\n]"; "") == "") then
    k
  else
    k + " " + (v | tostring | gsub("[\t\r\n]"; " "))
  end;
emit("model"; .model.display_name)
, emit("five_pct"; .rate_limits.five_hour.used_percentage)
, emit("five_reset"; .rate_limits.five_hour.resets_at)
, emit("seven_pct"; .rate_limits.seven_day.used_percentage)
, emit("seven_reset"; .rate_limits.seven_day.resets_at)
, emit("spend_pct"; .rate_limits.spend_limit.used_percentage)
, emit("spend_used"; .rate_limits.spend_limit.used_usd)
, emit("spend_limit"; .rate_limits.spend_limit.limit_usd)
, emit("ctx";
    .context_window.used_percentage
    // .context_window.used_percent
    // .context_window.percentage
    // .context.used_percentage
    // .context_usage.used_percentage
    // null
  )
, emit("style";
    if (.output_style.name == null) then null
    elif ((.output_style.name | ascii_downcase) == "default") then null
    else .output_style.name end)
, emit("ctx_size"; .context_window.context_window_size // .context_window.size)
, emit("ctx_tokens"; .context_window.context_tokens // .context_window.total_input_tokens)
, emit("compact_at"; .context_window.auto_compact_threshold_percent)
, emit("cost_usd"; .cost.total_cost_usd)
, emit("cost_ms"; .cost.total_duration_ms)
, emit("lines_added"; .cost.total_lines_added)
, emit("lines_removed"; .cost.total_lines_removed)
, emit("compactions"; .context_window.auto_compact_count // .cost.auto_compactions)
, emit("vim"; .vim.mode)
, emit("session"; .session_id)
, emit("pr_number"; .pr.number)
, emit("pr_state"; .pr.review_state // .pr.kind)
, emit("repo";
    if (.workspace.repo.owner != null and .workspace.repo.name != null) then
      (.workspace.repo.owner + "/" + .workspace.repo.name)
    elif .workspace.repo.name != null then .workspace.repo.name
    else null end)
, emit("cwd"; .workspace.current_dir // .cwd)
, emit("project_dir"; .workspace.project_dir)
, emit("version"; .version)
, emit("effort"; .effort.level)
, emit("title"; .session_name)
, emit("in_tokens"; .context_window.total_input_tokens)
, emit("out_tokens"; .context_window.total_output_tokens)
, emit("cache_warm";
    if .prompt_cache.warm == true then "true"
    elif .prompt_cache.warm == false then "false"
    else null end)
, emit("cache_cause"; .prompt_cache.last_miss_cause.causes[0])
, emit("columns"; .render_width_chars)
'

assign_field() {
  local line="$1" key val
  [[ -z "$line" ]] && return 0
  key=${line%% *}
  if [[ "$line" == *" "* ]]; then
    val=${line#* }
  else
    val=""
  fi
  case "$key" in
    model) model=$val ;;
    five_pct) five_pct=$val ;;
    five_reset) five_raw=$val ;;
    seven_pct) seven_pct=$val ;;
    seven_reset) seven_raw=$val ;;
    spend_pct) spend_pct=$val ;;
    spend_used) spend_used=$val ;;
    spend_limit) spend_limit=$val ;;
    ctx) ctx=$val ;;
    style) style=$val ;;
    ctx_size) ctx_size=$val ;;
    ctx_tokens) ctx_tokens=$val ;;
    compact_at) compact_at=$val ;;
    cost_usd) cost_usd=$val ;;
    cost_ms) cost_ms=$val ;;
    lines_added) lines_added=$val ;;
    lines_removed) lines_removed=$val ;;
    compactions) compactions=$val ;;
    vim) vim_mode=$val ;;
    session) session_id=$val ;;
    pr_number) pr_number=$val ;;
    pr_state) pr_state=$val ;;
    repo) repo=$val ;;
    cwd) cwd=$val ;;
    project_dir) project_dir=$val ;;
    version) cc_version=$val ;;
    effort) effort=$val ;;
    title) title=$val ;;
    in_tokens) in_tokens=$val ;;
    out_tokens) out_tokens=$val ;;
    cache_warm) cache_warm=$val ;;
    cache_cause) cache_cause=$val ;;
    columns) render_cols=$val ;;
    codex5) codex5=$val ;;
    codex5_reset) codex5_raw=$val ;;
    codex7) codex7=$val ;;
    codex7_reset) codex7_raw=$val ;;
  esac
}

parse_fields() {
  local blob="$1" line
  while IFS= read -r line; do
    assign_field "$line"
  done < <(printf '%s\n' "$blob")
}

# Codex numbers come from Pharos (~/.pharos/usage.json). The Claude Code status line
# never reads another tool's files; without Pharos there is no codex segment.
scan_codex() {
  local parsed
  command -v python3 >/dev/null 2>&1 || return 1
  parsed=$(LIMITLINE_NOW="$NOW" python3 "$LIMITLINE_ROOT/lib/pharos_view.py" --codex-fields 2>/dev/null) || return 1
  codex5=""
  codex5_raw=""
  codex7=""
  codex7_raw=""
  parse_fields "$parsed"
  [[ -n "$codex5" || -n "$codex7" ]] || return 1
  return 0
}

write_codex_cache() {
  local ok="$1" dest tmp dash
  [[ -z "${LIMITLINE_PHAROS_USAGE:-}" && "${LIMITLINE_NOCACHE:-}" != "1" ]] || return 0
  dest=$(codex_cache_file)
  tmp="${dest}.$$"
  dash() {
    if [[ -z "$1" ]]; then printf '%s' "-"; else printf '%s' "$1"; fi
  }
  printf '%s %s %s %s %s %s\n' "$(date +%s)" "$ok" "$(dash "$codex5")" "$(dash "$codex5_raw")" "$(dash "$codex7")" "$(dash "$codex7_raw")" > "$tmp" 2>/dev/null \
    && mv "$tmp" "$dest" 2>/dev/null || true
}

scanned=0
if command -v jq >/dev/null 2>&1; then
  tsv=$(printf '%s' "$input" | jq -r "$JQ_PROG" 2>/dev/null) || exit 0
  parse_fields "$tsv"
  if [[ "$CODEX_ENABLED" -eq 1 && "$cache_hit" -eq 0 ]]; then
    if scan_codex; then
      write_codex_cache 1
    else
      codex5=""
      codex5_raw=""
      codex7=""
      codex7_raw=""
      write_codex_cache 0
    fi
    scanned=1
  fi
else
  if ! command -v python3 >/dev/null 2>&1; then
    exit 0
  fi
  scan_flag=0
  if [[ "$CODEX_ENABLED" -eq 1 && "$cache_hit" -eq 0 ]]; then
    scan_flag=1
  fi
  tsv=$(
    LIMITLINE_INPUT="$input" \
    python3 - << 'PY' 2>/dev/null
import json, os, sys

raw = os.environ.get("LIMITLINE_INPUT", "")
try:
    data = json.loads(raw)
except Exception:
    sys.exit(2)
if not isinstance(data, dict):
    data = {}

def dig(obj, *path):
    cur = obj
    for key in path:
        if not isinstance(cur, dict) or key not in cur:
            return None
        cur = cur[key]
    return cur

def cell(value):
    if value is None or isinstance(value, bool):
        return ""
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        if value != value:
            return ""
        text = ("%f" % value).rstrip("0").rstrip(".")
        return text
    return str(value).replace("\t", " ").replace("\n", " ").replace("\r", " ")

def emit(key, value):
    text = cell(value)
    if text == "":
        return key
    return key + " " + text

model = dig(data, "model", "display_name")
five = dig(data, "rate_limits", "five_hour") or {}
seven = dig(data, "rate_limits", "seven_day") or {}
spend = dig(data, "rate_limits", "spend_limit") or {}
if not isinstance(five, dict):
    five = {}
if not isinstance(seven, dict):
    seven = {}
if not isinstance(spend, dict):
    spend = {}

ctx = None
for path in (
    ("context_window", "used_percentage"),
    ("context_window", "used_percent"),
    ("context_window", "percentage"),
    ("context", "used_percentage"),
    ("context_usage", "used_percentage"),
):
    val = dig(data, *path)
    if isinstance(val, (int, float)) and not isinstance(val, bool):
        ctx = val
        break

style = dig(data, "output_style", "name")
if isinstance(style, str) and style.lower() == "default":
    style = None
ctx_size = dig(data, "context_window", "context_window_size")
if not isinstance(ctx_size, (int, float)):
    ctx_size = dig(data, "context_window", "size")
ctx_tokens = dig(data, "context_window", "context_tokens")
if not isinstance(ctx_tokens, (int, float)):
    ctx_tokens = dig(data, "context_window", "total_input_tokens")
compact_at = dig(data, "context_window", "auto_compact_threshold_percent")
cost = dig(data, "cost") if isinstance(dig(data, "cost"), dict) else {}
compactions = dig(data, "context_window", "auto_compact_count")
if not isinstance(compactions, (int, float)) or isinstance(compactions, bool):
    compactions = cost.get("auto_compactions")
vim_mode = dig(data, "vim", "mode")
session_id = dig(data, "session_id")
pr = dig(data, "pr") if isinstance(dig(data, "pr"), dict) else {}
repo_obj = dig(data, "workspace", "repo") if isinstance(dig(data, "workspace", "repo"), dict) else {}
if repo_obj.get("owner") and repo_obj.get("name"):
    repo_s = str(repo_obj.get("owner")) + "/" + str(repo_obj.get("name"))
elif repo_obj.get("name"):
    repo_s = str(repo_obj.get("name"))
else:
    repo_s = ""
cwd = dig(data, "workspace", "current_dir") or dig(data, "cwd")
project_dir = dig(data, "workspace", "project_dir")
cc_version = dig(data, "version")
effort = dig(data, "effort", "level")
title = dig(data, "session_name")
in_tokens = dig(data, "context_window", "total_input_tokens")
out_tokens = dig(data, "context_window", "total_output_tokens")
pcache = dig(data, "prompt_cache") if isinstance(dig(data, "prompt_cache"), dict) else {}
warm = pcache.get("warm", None)
if warm is True:
    cache_warm = "true"
elif warm is False:
    cache_warm = "false"
else:
    cache_warm = ""
miss = pcache.get("last_miss_cause") if isinstance(pcache.get("last_miss_cause"), dict) else {}
causes = miss.get("causes") if isinstance(miss.get("causes"), list) else []
cache_cause = str(causes[0]) if causes else ""
columns = data.get("render_width_chars")

lines = [
    emit("model", model),
    emit("five_pct", five.get("used_percentage")),
    emit("five_reset", five.get("resets_at")),
    emit("seven_pct", seven.get("used_percentage")),
    emit("seven_reset", seven.get("resets_at")),
    emit("spend_pct", spend.get("used_percentage")),
    emit("spend_used", spend.get("used_usd")),
    emit("spend_limit", spend.get("limit_usd")),
    emit("ctx", ctx),
    emit("style", style),
    emit("ctx_size", ctx_size),
    emit("ctx_tokens", ctx_tokens),
    emit("compact_at", compact_at),
    emit("cost_usd", cost.get("total_cost_usd")),
    emit("cost_ms", cost.get("total_duration_ms")),
    emit("lines_added", cost.get("total_lines_added")),
    emit("lines_removed", cost.get("total_lines_removed")),
    emit("compactions", compactions),
    emit("vim", vim_mode),
    emit("session", session_id),
    emit("pr_number", pr.get("number")),
    emit("pr_state", pr.get("review_state") or pr.get("kind")),
    emit("repo", repo_s),
    emit("cwd", cwd),
    emit("project_dir", project_dir),
    emit("version", cc_version),
    emit("effort", effort),
    emit("title", title),
    emit("in_tokens", in_tokens),
    emit("out_tokens", out_tokens),
    emit("cache_warm", cache_warm),
    emit("cache_cause", cache_cause),
    emit("columns", columns),
]
sys.stdout.write("\n".join(lines) + "\n")
PY
  ) || exit 0
  parse_fields "$tsv"
  if [[ "$scan_flag" -eq 1 ]]; then
    if scan_codex; then
      write_codex_cache 1
    else
      codex5=""
      codex5_raw=""
      codex7=""
      codex7_raw=""
      write_codex_cache 0
    fi
    scanned=1
  fi
fi

five_epoch=$(to_epoch "$five_raw")
seven_epoch=$(to_epoch "$seven_raw")
five_abs=$(abs_label "$five_epoch")
seven_abs=$(abs_label "$seven_epoch")

# Claude Code sends no rate_limits until a session's first reply. The 7-day window
# belongs to the account, so the last reading any session cached in claude.json
# stands in, shown with its age (`7d 67% · 4m ago`). A reading whose reset has
# passed belongs to last week and is not shown as current.
seven_cached_pct=""
seven_cached_reset=""
seven_cached_at=""
seven_age=""
seven_note=""
claude_snap="${LIMITLINE_CLAUDE_SNAPSHOT:-${XDG_CACHE_HOME:-$HOME/.cache}/limitline/claude.json}"
if [[ -z "$seven_pct" && ( "$ON_SEVEN" == "1" || -n "$five_pct" ) && "${LIMITLINE_CLAUDE_CACHE:-1}" != "0" && -f "$claude_snap" ]]; then
  snap_line=""
  IFS= read -r snap_line < "$claude_snap" || true
  re_win='\{"name":"7d","used_pct":([0-9.]+)(,"resets_at":([0-9]+))?(,"observed_at":([0-9]+))?\}'
  re_top='^\{"observed_at":([0-9]+)'
  if [[ "$snap_line" =~ $re_win ]]; then
    seven_cached_pct="${BASH_REMATCH[1]}"
    seven_cached_reset="${BASH_REMATCH[3]}"
    seven_cached_at="${BASH_REMATCH[5]}"
    if [[ -z "$seven_cached_at" && "$snap_line" =~ $re_top ]]; then
      seven_cached_at="${BASH_REMATCH[1]}"
    fi
    if [[ -z "$seven_cached_at" ]]; then
      seven_cached_pct=""
    elif [[ -n "$seven_cached_reset" ]]; then
      if [[ "$seven_cached_reset" -le "$NOW" ]]; then
        # Not hidden, and not last week's percent either: say the week reset.
        seven_cached_pct=""
        seven_note="7d reset $(LC_TIME=C date -r "$seven_cached_reset" "+%a %H:%M" 2>/dev/null \
          || LC_TIME=C date -d "@$seven_cached_reset" "+%a %H:%M" 2>/dev/null || true) · no newer reading"
      fi
    elif [[ $((NOW - seven_cached_at)) -ge 604800 ]]; then
      seven_cached_pct=""
    fi
  fi
fi

case "$model" in
  "Claude "*) model="${model#Claude }" ;;
esac

write_snapshot() {
  local dir dest windows item pct reset
  [[ -n "$five_pct" || -n "$seven_pct" || -n "$spend_pct" || -n "$spend_used" ]] || return 0
  dir="${XDG_CACHE_HOME:-$HOME/.cache}/limitline"
  [[ -d "$dir" ]] || mkdir -p "$dir" 2>/dev/null || return 0
  dest="${LIMITLINE_CLAUDE_SNAPSHOT:-$dir/claude.json}"
  windows=""
  add_win() {
    pct="$1"; reset="$2"; name="$3"
    case "$pct" in ''|*[!0-9.]*) return 0 ;; esac
    item=$(printf '{"name":"%s","used_pct":%s' "$name" "$pct")
    case "$reset" in
      ''|*[!0-9]*) ;;
      *) item="$item"',"resets_at":'"$reset" ;;
    esac
    # A carried-over window keeps the time it was really read.
    case "${4:-}" in
      ''|*[!0-9]*) ;;
      *) item="$item"',"observed_at":'"$4" ;;
    esac
    item="$item}"
    if [[ -z "$windows" ]]; then windows="$item"; else windows="$windows,$item"; fi
  }
  add_win "$five_pct" "$five_epoch" "5h"
  if [[ -n "$seven_pct" ]]; then
    add_win "$seven_pct" "$seven_epoch" "7d"
  elif [[ -n "$seven_cached_pct" ]]; then
    # A reply with only the 5h window must not erase the cached week.
    add_win "$seven_cached_pct" "$seven_cached_reset" "7d" "$seven_cached_at"
  fi
  spend_json=""
  case "$spend_used" in ''|*[!0-9.]*) ;; *)
    case "$spend_limit" in ''|*[!0-9.]*) ;; *)
      spend_json=$(printf '"spend":{"used":%s,"limit":%s,"currency":"USD"},' "$spend_used" "$spend_limit")
    ;; esac
  ;; esac
  printf '{"observed_at":%s,"provider":"claude","source":"statusline","stale":false,%s"windows":[%s]}\n' \
    "$NOW" "$spend_json" "$windows" > "$dest" 2>/dev/null || true
  # Claude Code gives these numbers only to the status line. Relay them, as-is, to Pharos.
  local ph="${LIMITLINE_PHAROS_HOME:-$HOME/.pharos}"
  if [[ -d "$ph" && -s "$dest" ]]; then
    mkdir -p "$ph/inbox" 2>/dev/null \
      && cp "$dest" "$ph/inbox/.claude.$$" 2>/dev/null \
      && mv -f "$ph/inbox/.claude.$$" "$ph/inbox/claude.json" 2>/dev/null || true
  fi
}
write_snapshot

append_sample() {
  local file="$1" ts="$2" pct="$3" dir tmp
  [[ -n "$pct" ]] || return 0
  dir=${file%/*}
  mkdir -p "$dir" 2>/dev/null || return 0
  tmp="${file}.$$"
  if [[ -f "$file" ]]; then
    awk -v ts="$ts" '$1 != ts { print }' "$file" 2>/dev/null | tail -n 399 > "$tmp" || true
  else
    : > "$tmp"
  fi
  printf '%s %s\n' "$ts" "$pct" >> "$tmp" 2>/dev/null || true
  mv "$tmp" "$file" 2>/dev/null || true
}

series_last() {
  local file="$1" count="$2"
  [[ -f "$file" ]] || return 0
  tail -n "$count" "$file" | awk 'NF >= 2 { p[++i] = $2 } END { for (j = 1; j <= i; j++) printf "%s%s", (j > 1 ? "," : ""), p[j] }'
}

series_days() {
  local file="$1" now="$2"
  [[ -f "$file" ]] || return 0
  awk -v now="$now" 'NF >= 2 { d = int($1 / 86400); last[d] = $2; seen[d] = 1 }
    END {
      today = int(now / 86400)
      out = ""
      for (d = today - 6; d <= today; d++) if (seen[d]) out = out (out == "" ? "" : ",") last[d]
      print out
    }' "$file"
}

quiet_now() {
  local hour="$1" start end
  [[ -z "$QUIET" || "$QUIET" != *-* ]] && return 1
  start=${QUIET%%-*}
  end=${QUIET#*-}
  case "$start" in ''|*[!0-9]*) return 1 ;; esac
  case "$end" in ''|*[!0-9]*) return 1 ;; esac
  start=$((10#$start))
  end=$((10#$end))
  if [[ "$start" -eq "$end" ]]; then
    return 1
  fi
  if [[ "$start" -lt "$end" ]]; then
    [[ "$hour" -ge "$start" && "$hour" -lt "$end" ]]
    return
  fi
  [[ "$hour" -ge "$start" || "$hour" -lt "$end" ]]
}

fire_alert() {
  local level="$1" pct="$2" msg log
  msg="5h ${pct}%"
  log="${LIMITLINE_ALERT_LOG:-}"
  if [[ -n "$log" ]]; then
    printf '%s %s %s\n' "$ALERTS_MODE" "$level" "$msg" >> "$log" 2>/dev/null || true
  fi
  case "$ALERTS_MODE" in
    bell) printf '\a' >&2 || true ;;
    notify)
      if command -v osascript >/dev/null 2>&1; then
        osascript -e "display notification \"$msg\" with title \"limitline\"" >/dev/null 2>&1 || true
      fi
      ;;
  esac
}

maybe_alert() {
  local pct hour dir state token level
  [[ "$ALERTS_MODE" == "off" ]] && return 0
  pct="${five_pct%%.*}"
  case "$pct" in ''|*[!0-9]*) return 0 ;; esac
  hour=$(date -r "$NOW" "+%H" 2>/dev/null || date -d "@$NOW" "+%H" 2>/dev/null || echo "")
  case "$hour" in ''|*[!0-9]*) hour=0 ;; esac
  hour=$((10#$hour))
  if quiet_now "$hour"; then
    return 0
  fi
  if [[ "$pct" -ge 95 ]]; then
    level=95
  elif [[ "$pct" -ge 80 ]]; then
    level=80
  else
    return 0
  fi
  dir="${XDG_CACHE_HOME:-$HOME/.cache}/limitline"
  mkdir -p "$dir" 2>/dev/null || return 0
  state="$dir/alerts.tsv"
  token="${five_epoch:-0}"
  if [[ -f "$state" ]] && grep -q -x -F "$level $token" "$state"; then
    return 0
  fi
  if [[ "$level" == "95" ]]; then
    if [[ ! -f "$state" ]] || ! grep -q -x -F "80 $token" "$state"; then
      printf '80 %s\n' "$token" >> "$state" 2>/dev/null || true
    fi
  fi
  printf '%s %s\n' "$level" "$token" >> "$state" 2>/dev/null || true
  fire_alert "$level" "$pct"
}

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/limitline"
hist_path=""
spark5=""
spark7=""
sparkle=0
nudge_text=""
value_text=""
cost_trend=""

if [[ "$ON_BURN" == "1" && -n "$five_pct" ]]; then
  mkdir -p "$cache_dir" 2>/dev/null || true
  hist_path="$cache_dir/history-5h.tsv"
  printf '%s %s\n' "$NOW" "$five_pct" >> "$hist_path" 2>/dev/null || true
fi
if [[ "$ON_SPARK" == "1" ]]; then
  if [[ -n "$five_pct" ]]; then
    append_sample "$cache_dir/history-5h.tsv" "$NOW" "$five_pct"
    spark5=$(series_last "$cache_dir/history-5h.tsv" 5)
  fi
  if [[ -n "$seven_pct" ]]; then
    append_sample "$cache_dir/history-7d.tsv" "$NOW" "$seven_pct"
    spark7=$(series_days "$cache_dir/history-7d.tsv" "$NOW")
  fi
fi

if [[ "$ON_FRESH" == "1" && -n "$five_epoch" && -n "$five_pct" ]]; then
  fresh_state="$cache_dir/fresh.state"
  prev_reset=""
  prev_pct=""
  shown=""
  mkdir -p "$cache_dir" 2>/dev/null || true
  if [[ -f "$fresh_state" ]]; then
    read -r prev_reset prev_pct shown < "$fresh_state" || true
  fi
  cur_i=${five_pct%%.*}
  prev_i=${prev_pct%%.*}
  case "$cur_i" in ''|*[!0-9]*) cur_i=0 ;; esac
  case "$prev_i" in ''|*[!0-9]*) prev_i=-1 ;; esac
  fell=0
  if [[ "$prev_i" -ge 40 && "$cur_i" -le 20 ]]; then
    fell=1
  fi
  if [[ "$fell" == "1" && "$shown" != "$five_epoch" ]]; then
    sparkle=1
    shown="$five_epoch"
  fi
  printf '%s %s %s\n' "$five_epoch" "$five_pct" "$shown" > "$fresh_state" 2>/dev/null || true
fi

maybe_alert

if [[ "$ON_NUDGE" == "1" ]]; then
  five_i=${five_pct%%.*}
  ctx_i=${ctx%%.*}
  warn_i=${AUTO_WARN%%.*}
  case "$five_i" in ''|*[!0-9]*) five_i=0 ;; esac
  case "$ctx_i" in ''|*[!0-9]*) ctx_i=0 ;; esac
  case "$warn_i" in ''|*[!0-9]*) warn_i=80 ;; esac
  if [[ "$five_i" -gt 80 ]]; then
    hint=$(python3 "$LIMITLINE_ROOT/lib/nudge.py" 2>/dev/null || true)
    hint=${hint//$'\n'/}
    [[ -n "$hint" ]] && nudge_text="→ $hint"
  fi
  if [[ "$ctx_i" -ge "$warn_i" ]]; then
    bit="↯ compact soon: /compact"
    if [[ -n "$nudge_text" ]]; then nudge_text="$nudge_text · $bit"; else nudge_text="$bit"; fi
  fi
  if [[ "$cache_warm" == "false" && "$ON_CACHE" != "1" ]]; then
    cause="${cache_cause:-miss}"
    bit="cache cold: $cause"
    if [[ -n "$nudge_text" ]]; then nudge_text="$nudge_text · $bit"; else nudge_text="$bit"; fi
  fi
fi

if [[ "$ON_VALUE" == "1" ]]; then
  value_text=$(python3 "$LIMITLINE_ROOT/lib/value.py" 2>/dev/null || true)
  value_text=${value_text//$'\n'/}
fi

if [[ "$ON_VITALS" == "1" && -n "$cost_usd" ]]; then
  cost_file="$cache_dir/history-cost.tsv"
  prev_line=""
  [[ -f "$cost_file" ]] && prev_line=$(tail -n 1 "$cost_file" 2>/dev/null || true)
  prev_cost=${prev_line#* }
  if [[ -n "$prev_line" && "$prev_cost" != "$prev_line" ]]; then
    cost_trend=$(awk -v c="$cost_usd" -v p="$prev_cost" 'BEGIN {
      if (c+0 > p+0 + 0.005) print "↑"
      else if (c+0 < p+0 - 0.005) print "↓"
      else print "·"
    }')
  fi
  append_sample "$cost_file" "$NOW" "$cost_usd"
fi

if [[ -n "$cwd" && "$cwd" != "$HOME" ]]; then
  project=${cwd##*/}
  case "$project" in
    ""|.|..|*@*|*/*) ;;
    *)
      hour=$(date -r "$NOW" "+%H" 2>/dev/null || date -d "@$NOW" "+%H" 2>/dev/null || echo "0")
      case "$hour" in ''|*[!0-9]*) hour=0 ;; esac
      mkdir -p "$cache_dir" 2>/dev/null || true
      printf '%s %s %s\n' "$NOW" "$((10#$hour))" "$project" >> "$cache_dir/activity.tsv" 2>/dev/null || true
      ;;
  esac
fi

# The folder Claude Code is in, without trailing slashes.
folder="$cwd"
while [[ "$folder" == */ && "$folder" != "/" ]]; do folder="${folder%/}"; done
folder_name="${folder##*/}"
[[ -z "$folder_name" && -n "$folder" ]] && folder_name="/"
dir_text=""
if [[ "$ON_DIR" == "1" && -n "$folder" ]]; then
  case "$DIR_STYLE" in
    home|path|full)
      dir_text="$folder"
      if [[ -n "$HOME" && "$folder" == "$HOME" ]]; then dir_text="~"
      elif [[ -n "$HOME" && "$folder" == "$HOME"/* ]]; then dir_text="~/${folder#"$HOME"/}"
      fi
      ;;
    *) dir_text="$folder_name" ;;
  esac
fi

# One git call gives the branch, the work tree's top, and the shared .git directory
# (outside the work tree for a linked worktree, which names the repository).
git_top=""
git_common=""
branch=""
in_repo=0
if [[ ( "$ON_GIT" == "1" && ( -n "$cwd" || -n "$repo" ) ) || ( "$ON_PROJECT" == "1" && -n "$cwd" && -d "$cwd" ) ]]; then
  target="${cwd:-$PWD}"
  rp=$(git -C "$target" rev-parse --show-toplevel --git-common-dir --abbrev-ref HEAD 2>/dev/null || true)
  if [[ -n "$rp" ]]; then
    { IFS= read -r git_top; IFS= read -r git_common; IFS= read -r branch; } <<< "$rp"
    [[ -n "$git_top" ]] && in_repo=1
    if [[ "$in_repo" == "1" && -z "$branch" ]]; then
      branch=$(git -C "$target" symbolic-ref --short HEAD 2>/dev/null || true)
    fi
  fi
fi

project_text=""
if [[ "$ON_PROJECT" == "1" && -n "$folder" ]]; then
  pname=""
  if [[ "$in_repo" == "1" ]]; then
    case "$git_common" in
      /*/.git) pname="${git_common%/.git}"; pname="${pname##*/}" ;;
      /*.git) pname="${git_common##*/}"; pname="${pname%.git}" ;;
      *) pname="${git_top##*/}" ;;
    esac
  elif [[ -n "$project_dir" ]]; then
    pname="${project_dir%/}"
    pname="${pname##*/}"
  fi
  if [[ -n "$pname" && "$pname" != "$folder_name" ]]; then project_text="$pname"; fi
fi

git_text=""
if [[ "$ON_GIT" == "1" && ( -n "$cwd" || -n "$repo" ) ]]; then
  dirty=""
  ahead=""
  behind=""
  if [[ "$in_repo" == "1" ]]; then
    if [[ -n "$(git -C "$target" status --porcelain 2>/dev/null | head -n 1)" ]]; then
      dirty="*"
    fi
    counts=$(git -C "$target" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null || true)
    # "BEHIND<TAB>AHEAD" (upstream is the left side). Keep only plain numbers.
    if [[ -n "$counts" ]]; then
      read -r behind ahead _ <<< "$counts"
      case "$behind" in ''|*[!0-9]*) behind="" ;; esac
      case "$ahead" in ''|*[!0-9]*) ahead="" ;; esac
    fi
  fi
  git_text="$repo"
  if [[ -n "$branch" ]]; then
    if [[ -n "$git_text" ]]; then git_text="$git_text $branch$dirty"; else git_text="$branch$dirty"; fi
    if [[ -n "$ahead" && "$ahead" != "0" ]]; then git_text="$git_text ↑$ahead"; fi
    if [[ -n "$behind" && "$behind" != "0" ]]; then git_text="$git_text ↓$behind"; fi
  fi
  if [[ "$LINKS" == "1" && "$repo" == */* && -n "$git_text" ]]; then
    git_text=$(printf '\033]8;;https://github.com/%s\a%s\033]8;;\a' "$repo" "$git_text")
  fi
fi

pr_text=""
if [[ "$ON_PR" == "1" && -n "$pr_number" ]]; then
  pr_text="PR #$pr_number"
  [[ -n "$pr_state" ]] && pr_text="$pr_text $pr_state"
  if [[ "$LINKS" == "1" && "$repo" == */* ]]; then
    pr_text=$(printf '\033]8;;https://github.com/%s/pull/%s\a%s\033]8;;\a' "$repo" "$pr_number" "$pr_text")
  fi
fi

cache_text=""
if [[ "$ON_CACHE" == "1" && "$cache_warm" == "false" ]]; then
  cause="$cache_cause"
  [[ -z "$cause" ]] && cause="miss"
  cache_text="cache cold: $cause"
fi

vim_text=""
if [[ "$ON_VIM" == "1" && -n "$vim_mode" ]]; then
  vim_text="vim $vim_mode"
fi

session_text=""
if [[ "$ON_SESSION" == "1" && -n "$session_id" ]]; then
  session_text=${session_id:0:6}
fi

version_text=""
if [[ "$ON_VERSION" == "1" && -n "$cc_version" ]]; then
  case "$cc_version" in v*) version_text="$cc_version" ;; *) version_text="v$cc_version" ;; esac
fi
effort_text=""
[[ "$ON_EFFORT" == "1" && -n "$effort" ]] && effort_text="effort $effort"
title_text=""
if [[ "$ON_TITLE" == "1" && -n "$title" ]]; then
  title_text="$title"
  # Characters, not bytes, under a UTF-8 locale; a long title is cut at 40.
  if [[ "${#title_text}" -gt 40 ]]; then title_text="${title_text:0:39}…"; fi
fi
[[ "$ON_TOKENS" == "1" ]] || { in_tokens=""; out_tokens=""; }
app_text=""
[[ "$ON_APP" == "1" ]] && app_text="Claude Code"

[[ "$ON_MODEL" == "1" ]] || model=""
[[ "$ON_STYLE" == "1" ]] || style=""
[[ "$ON_CTX" == "1" ]] || ctx=""
[[ "$ON_SPEND" == "1" ]] || { spend_pct=""; spend_used=""; spend_limit=""; }
# 0.14 also cleared these when `segments` named vitals without cost (no vitals shown);
# configs with their own `segments` keep that, the 0.15 layouts do not.
[[ "$ON_COST" == "1" || ( "$FMT" == "new" && "$ON_VITALS" == "1" ) ]] || { cost_usd=""; cost_ms=""; lines_added=""; lines_removed=""; }
[[ "$ON_CODEX" == "1" ]] || { codex5=""; codex7=""; }
[[ "$ON_BURN" == "1" ]] || hist_path=""

# A file's mtime in epoch seconds, or 0. Each form is tried on its own: GNU stat reads
# `-f` as --file-system, so `stat -f %m FILE` prints FILE's file system and exits 1, and
# chaining it with `|| stat -c %Y` in one capture glued that text onto the mtime.
file_mtime() {
  local m
  m=$(stat -c %Y "$1" 2>/dev/null) && [[ "$m" =~ ^[0-9]+$ ]] && { printf '%s' "$m"; return 0; }
  m=$(stat -f %m "$1" 2>/dev/null) && [[ "$m" =~ ^[0-9]+$ ]] && { printf '%s' "$m"; return 0; }
  printf '0'
}

fresh_line() {
  local file="$1" ttl="$2" now mtime age line
  [[ -f "$file" ]] || return 0
  now=$(date +%s)
  mtime=$(file_mtime "$file")
  case "$mtime" in ''|*[!0-9]*|0) return 0 ;; esac
  age=$((now - mtime))
  if [[ "$age" -gt "$ttl" ]]; then
    return 0
  fi
  IFS= read -r line < "$file" || true
  printf '%s' "$line"
}

kick_refresh() {
  [[ "${LIMITLINE_REFRESH:-1}" == "0" ]] && return 0
  local lock now mtime
  mkdir -p "$cache_dir" 2>/dev/null || return 0
  lock="$cache_dir/refresh.lock"
  now=$(date +%s)
  if [[ -f "$lock" ]]; then
    mtime=$(file_mtime "$lock")
    case "$mtime" in ''|*[!0-9]*) mtime=0 ;; esac
    if [[ $((now - mtime)) -lt 30 ]]; then
      return 0
    fi
  fi
  : > "$lock" 2>/dev/null || return 0
  # --no-fetch: the Grok plan fetch (a pty session) never starts from the status line.
  nohup python3 "$LIMITLINE_ROOT/lib/refresh.py" --no-fetch >/dev/null 2>&1 &
}

fleet_text=""
machines_text=""
fleet_file="${LIMITLINE_FLEET_LINE:-$cache_dir/fleet.line}"
machines_file="${LIMITLINE_MACHINES_LINE:-$cache_dir/machines.line}"
need_refresh=0
if [[ "$ON_FLEET" == "1" ]]; then
  fleet_text=$(fresh_line "$fleet_file" "$FLEET_TTL")
  [[ -n "$fleet_text" ]] || need_refresh=1
fi
if [[ "$ON_MACHINES" == "1" ]]; then
  machines_text=$(fresh_line "$machines_file" "$MACHINES_TTL")
  [[ -n "$machines_text" ]] || need_refresh=1
fi
# Grok has no quota. The segment is the plan and 7-day session tokens that
# limitline refresh read from ~/.grok, never a percent.
grok_text=""
grok_file="${LIMITLINE_GROK_LINE:-$cache_dir/grok.line}"
grok_flags=""
if [[ "$ON_GROK" == "1" ]]; then
  grok_text=$(fresh_line "$grok_file" "$GROK_TTL")
  if [[ -n "$grok_text" ]]; then
    # Line 2 is `pct stale` when the shared Cursor + Grok plan cache is present.
    { IFS= read -r _skip; IFS= read -r grok_flags; } < "$grok_file" 2>/dev/null || true
  else
    need_refresh=1
  fi
fi
# Background jobs from limitline job update. Nothing is read until a job was reported.
jobs_text=""
jobs_file="${LIMITLINE_JOBS_LINE:-$cache_dir/jobs.line}"
if [[ "$ON_JOBS" == "1" ]]; then
  if [[ -f "$jobs_file" ]]; then
    jobs_text=$(fresh_line "$jobs_file" "$JOBS_TTL")
    if [[ -z "$jobs_text" && -s "$jobs_file" ]]; then
      need_refresh=1
    fi
  else
    need_refresh=1
  fi
fi
if [[ "$need_refresh" == "1" ]]; then
  kick_refresh
fi

max_cols="${LIMITLINE_COLUMNS:-${COLUMNS:-}}"
if [[ -z "$max_cols" && -n "$render_cols" ]]; then max_cols="$render_cols"; fi
case "$max_cols" in ''|*[!0-9]*) max_cols=0 ;; esac

emit_kv() {
  if [[ -z "$2" ]]; then printf '%s\n' "$1"; else printf '%s %s\n' "$1" "$2"; fi
}

if [[ "$ON_SEVEN" == "1" && -z "$seven_pct" && -n "$seven_cached_pct" ]]; then
  seven_pct="$seven_cached_pct"
  seven_epoch="$seven_cached_reset"
  seven_abs=$(abs_label "$seven_epoch")
  snap_age=$((NOW - seven_cached_at))
  [[ "$snap_age" -ge 0 ]] || snap_age=0
  if [[ "$snap_age" -lt 60 ]]; then seven_age="<1m ago"
  elif [[ "$snap_age" -lt 3600 ]]; then seven_age="$((snap_age / 60))m ago"
  elif [[ "$snap_age" -lt 86400 ]]; then seven_age="$((snap_age / 3600))h ago"
  else seven_age="$((snap_age / 86400))d ago"
  fi
fi

{
  emit_kv theme "$THEME"
  emit_kv lines "$LINES"
  emit_kv width "$BAR_WIDTH"
  emit_kv max_cols "$max_cols"
  emit_kv use_color "$USE_COLOR"
  emit_kv now "$NOW"
  emit_kv model "$model"
  emit_kv style "$style"
  emit_kv ctx "$ctx"
  emit_kv ctx_size "$ctx_size"
  emit_kv ctx_tokens "$ctx_tokens"
  emit_kv compact_at "${compact_at:-$AUTO_AT}"
  emit_kv auto_warn "$AUTO_WARN"
  emit_kv five_pct "$five_pct"
  emit_kv five_reset "$five_epoch"
  emit_kv five_abs "$five_abs"
  emit_kv seven_pct "$seven_pct"
  emit_kv seven_reset "$seven_epoch"
  emit_kv seven_abs "$seven_abs"
  emit_kv seven_age "$seven_age"
  [[ "$ON_SEVEN" == "1" && -z "$seven_pct" ]] && emit_kv seven_note "$seven_note"
  emit_kv spend_pct "$spend_pct"
  emit_kv spend_used "$spend_used"
  emit_kv spend_limit "$spend_limit"
  emit_kv cost_usd "$cost_usd"
  emit_kv cost_ms "$cost_ms"
  emit_kv lines_added "$lines_added"
  emit_kv lines_removed "$lines_removed"
  emit_kv git "$git_text"
  emit_kv pr "$pr_text"
  emit_kv cache "$cache_text"
  emit_kv vim "$vim_text"
  emit_kv session "$session_text"
  emit_kv codex5 "$codex5"
  emit_kv codex7 "$codex7"
  emit_kv hist "$hist_path"
  emit_kv show_five "$ON_FIVE"
  emit_kv show_seven "$ON_SEVEN"
  emit_kv pace "$ON_PACE"
  emit_kv spark "$ON_SPARK"
  emit_kv fresh "$ON_FRESH"
  emit_kv vitals "$ON_VITALS"
  emit_kv spark5 "$spark5"
  emit_kv spark7 "$spark7"
  emit_kv nudge "$nudge_text"
  emit_kv value "$value_text"
  emit_kv fleet "$fleet_text"
  emit_kv machines "$machines_text"
  emit_kv grok "$grok_text"
  emit_kv grok_flags "$grok_flags"
  emit_kv jobs "$jobs_text"
  emit_kv order "$ORDER_LIST"
  emit_kv sparkle "$sparkle"
  emit_kv compactions "$compactions"
  emit_kv cost_trend "$cost_trend"
  emit_kv fmt "$FMT"
  emit_kv dir "$dir_text"
  emit_kv project "$project_text"
  emit_kv version "$version_text"
  emit_kv effort "$effort_text"
  emit_kv title "$title_text"
  emit_kv app "$app_text"
  emit_kv in_tokens "$in_tokens"
  emit_kv out_tokens "$out_tokens"
} | LC_ALL=C awk '
function val(k) { return (k in v) ? v[k] : "" }
function pct(p) {
  if (p < 0) p = 0
  if (p > 999) p = 999
  return int(p + 0.5)
}
function color_of(p) {
  if (p > 80) return "31"
  else if (p >= 50) return "33"
  return "32"
}
function paint(code, text) {
  if (val("use_color") != "1" || val("theme") == "mono") return text
  return sprintf("%c[%sm%s%c[0m", 27, code, text, 27)
}
function mark_of(p) {
  if (p > 80) return "!"
  else if (p >= 50) return "+"
  return "·"
}
function bar(p,    w, f, i, s, fill, empty) {
  w = val("width") + 0
  if (w < 1) w = 5
  if (p < 0) p = 0
  if (p > 100) p = 100
  f = int(p * w / 100 + 0.5)
  if (f < 0) f = 0
  if (f > w) f = w
  if (val("theme") == "ascii") { fill = "#"; empty = "-" }
  else if (val("theme") == "powerline") { fill = "█"; empty = "░" }
  else { fill = "▓"; empty = "░" }
  s = ""
  for (i = 0; i < f; i++) s = s fill
  for (i = 0; i < (w - f); i++) s = s empty
  return s
}
function rel(epoch, now,    d, h, m) {
  d = epoch - now
  if (d < 0) d = 0
  h = int(d / 3600)
  m = int((d % 3600) / 60)
  if (h > 0) return sprintf("%dh%dm", h, m)
  return sprintf("%dm", m)
}
function reset_bit(epoch, abs,    now, d, glyph) {
  if (epoch == "") return ""
  now = val("now") + 0
  d = (epoch + 0) - now
  if (val("fresh") == "1") {
    if (d >= 86400) {
      if (abs != "") return " fresh " abs
      return ""
    }
    return " fresh in " rel(epoch + 0, now)
  }
  if (val("theme") == "ascii" || val("theme") == "mono") glyph = " in "
  else if (val("theme") == "emoji") glyph = " ⏳"
  else glyph = " ↻"
  if (d >= 86400) {
    if (abs != "") return glyph abs
    return ""
  }
  return glyph rel(epoch + 0, now)
}
function meter(p) {
  if (val("theme") == "mono") return pct(p) "%"
  return paint(color_of(p + 0), bar(p + 0) " " mark_of(p + 0) pct(p + 0) "%")
}
function money(n,    x, nearest, diff) {
  x = n + 0
  nearest = int(x + 0.5)
  diff = x - nearest
  if (diff < 0) diff = -diff
  if (diff < 0.001) return sprintf("%d", nearest)
  return sprintf("%.2f", x)
}
function dur(ms,    s, h, m) {
  if (ms == "") return ""
  s = int((ms + 0) / 1000)
  if (s < 0) s = 0
  h = int(s / 3600)
  m = int((s % 3600) / 60)
  if (h > 0) return sprintf("%dh%dm", h, m)
  if (m > 0) return sprintf("%dm", m)
  return sprintf("%ds", s)
}
function window_seg(label, p, reset, abs) {
  if (p == "") return ""
  return label " " meter(p) reset_bit(reset, abs)
}
function spend_seg(p, used, limit,    body, money_s) {
  if (p == "" && used == "" && limit == "") return ""
  if (p == "" && used != "" && limit != "" && (limit + 0) != 0)
    p = (used + 0) / (limit + 0) * 100
  body = ""
  if (p != "") body = meter(p)
  money_s = ""
  if (used != "" && limit != "") money_s = "$" money(used) "/$" money(limit)
  if (body != "" && money_s != "") return "spend " body " " money_s
  if (body != "") return "spend " body
  if (money_s != "") return "spend " money_s
  return ""
}
# 0.15 wording ("new"); a config with its own `segments` keeps 0.14 ("old").
function newfmt() { return val("fmt") != "old" }
function commas(n,    s, out, neg) {
  s = sprintf("%d", n + 0)
  neg = ""
  if (substr(s, 1, 1) == "-") { neg = "-"; s = substr(s, 2) }
  out = ""
  while (length(s) > 3) {
    out = "," substr(s, length(s) - 2) out
    s = substr(s, 1, length(s) - 3)
  }
  return neg s out
}
# +17,898 −506 (a real minus sign; ascii keeps "-").
function line_counts(added, removed,    minus) {
  if (added == "") added = "0"
  if (removed == "") removed = "0"
  if (!newfmt()) return "+" int(added + 0) " -" int(removed + 0)
  minus = (val("theme") == "ascii") ? "-" : "−"
  return "+" commas(added) " " minus commas(removed)
}
function tok(n,    s) {
  n = n + 0
  if (n < 1000) return sprintf("%d", n)
  if (n < 10000) { s = sprintf("%.1fk", n / 1000); sub(/\.0k$/, "k", s); return s }
  if (n < 999500) return sprintf("%.0fk", n / 1000)
  s = sprintf("%.1fM", n / 1000000); sub(/\.0M$/, "M", s); return s
}
function tokens_seg(a, b,    out) {
  if ((a == "" || a + 0 == 0) && (b == "" || b + 0 == 0)) return ""
  out = ""
  if (a != "") out = tok(a) " in"
  if (b != "") out = (out == "" ? "" : out " · ") tok(b) " out"
  return out
}
function cost_seg(usd, ms, added, removed,    parts, text) {
  parts = ""
  if (usd != "") {
    text = "$" money(usd)
    if (text != "$0") parts = text
  }
  text = dur(ms)
  if (text != "" && text != "0s") {
    if (parts != "") parts = parts " " text
    else parts = text
  }
  if (added != "" || removed != "") {
    text = line_counts(added, removed)
    if (parts != "") parts = parts " " text
    else parts = text
  }
  return parts
}
function compact_pct(p) {
  return paint(color_of(p + 0), mark_of(p + 0) pct(p + 0) "%")
}
function grok_seg(text,    flags, n, f, head, p) {
  if (text == "") return ""
  flags = val("grok_flags")
  if (flags == "") return text
  n = split(flags, f, " ")
  if (f[2] == "1") return paint("2", text)
  head = "cursor+grok "
  p = f[1]
  if (p == "-" || p == "" || substr(text, 1, length(head)) != head) return text
  if (substr(text, length(head) + 1, length(p) + 1) != p "%") return text
  return head compact_pct(p) substr(text, length(head) + length(p) + 2)
}
function codex_seg(a, b,    left, right, out) {
  left = ""; right = ""
  if (a != "") left = "5h " compact_pct(a)
  if (b != "") right = "7d " compact_pct(b)
  if (left != "" && right != "") out = left " · " right
  else out = left right
  if (out == "") return ""
  return "codex " out
}
function ctx_note(pct, size, tokens, at, warn,    left, extra, gap, note) {
  if (pct == "") return ""
  extra = ""
  if (size ~ /^[0-9.]+$/) {
    if (tokens ~ /^[0-9.]+$/) left = size - tokens
    else left = size * (100 - pct) / 100
    if (left >= 1000) extra = sprintf("%.0fk left", left / 1000)
    else if (left > 0) extra = sprintf("%.0f left", left)
  }
  if (pct + 0 >= warn + 0) {
    gap = int((at + 0) - (pct + 0) + 0.5)
    if (gap > 0) note = sprintf("↯ auto-compact in ~%d%%", gap)
    else note = "↯ auto-compact"
    if (extra != "") extra = extra (newfmt() ? " · " : " ") note
    else extra = note
  }
  return extra
}
function ctx_seg(p, extra,    body) {
  if (p == "") return ""
  if (!newfmt()) body = "ctx " meter(p)
  else if (val("theme") == "mono") body = "ctx " pct(p) "%"
  else body = "ctx " paint(color_of(p + 0), bar(p + 0) " " pct(p + 0) "%")
  if (extra != "") body = body (newfmt() ? " · " : " ") extra
  return body
}
function sep_of(    theme) {
  theme = val("theme")
  if (theme == "powerline" || theme == "mono") return "  "
  if (theme == "pill") return " "
  if (theme == "ascii") return " | "
  if (val("use_color") == "1") return sprintf(" %c[2m│%c[0m ", 27, 27)
  return " │ "
}
function themed(kind, text,    prefix) {
  if (text == "") return ""
  prefix = ""
  if (val("theme") == "emoji") {
    if (kind == "model") prefix = "🧠 "
    else if (kind == "style") prefix = "🎨 "
    else if (kind == "ctx") prefix = "🪟 "
    else if (kind == "5h") prefix = "⏱ "
    else if (kind == "7d") prefix = "📅 "
    else if (kind == "spend") prefix = "💳 "
    else if (kind == "cost") prefix = "💵 "
    else if (kind == "git") prefix = "🌿 "
    else if (kind == "pr") prefix = "🔀 "
    else if (kind == "cache") prefix = "❄ "
    else if (kind == "vim") prefix = "✏ "
    else if (kind == "codex") prefix = "⌘ "
    else if (kind == "grok") prefix = "🤖 "
    else if (kind == "jobs") prefix = "🛠 "
    else if (kind == "vitals" && newfmt()) prefix = "⏱ "
    else if (kind == "session" || kind == "vitals") prefix = "♥ "
    else if (kind == "dir") prefix = "📁 "
    else if (kind == "project") prefix = "📦 "
    else if (kind == "version") prefix = "🏷 "
    else if (kind == "tokens") prefix = "🔢 "
    else if (kind == "effort") prefix = "💭 "
    else if (kind == "title") prefix = "📝 "
    else if (kind == "spark") prefix = "📈 "
    else if (kind == "pace") prefix = "🏃 "
    else if (kind == "nudge") prefix = "💡 "
    else if (kind == "value") prefix = "💰 "
  }
  text = prefix text
  if (val("theme") == "pill") return "⟨" text "⟩"
  return text
}
function spark_block(p,    idx) {
  if (p < 0) p = 0
  if (p > 100) p = 100
  idx = int(p * 8 / 100)
  if (idx > 7) idx = 7
  if (idx < 0) idx = 0
  if (idx == 0) return "▁"
  if (idx == 1) return "▂"
  if (idx == 2) return "▃"
  if (idx == 3) return "▄"
  if (idx == 4) return "▅"
  if (idx == 5) return "▆"
  if (idx == 6) return "▇"
  return "█"
}
function spark_seg(label, series, current,    n, i, blocks, parts) {
  if (val("spark") != "1" || series == "" || current == "") return ""
  n = split(series, parts, ",")
  if (n < 2) return ""
  blocks = ""
  for (i = 1; i <= n; i++) blocks = blocks spark_block(parts[i] + 0)
  return label " " blocks " " pct(current) "%"
}
function dot_join(a, b) {
  if (a == "") return b
  if (b == "") return a
  return a " · " b
}
function pace_one(label, used, reset, window,    now, left, elapsed, gap, phrase, days, per, extra) {
  if (val("pace") != "1" || used == "" || reset == "") return ""
  now = val("now") + 0
  left = (reset + 0) - now
  if (left < 0) left = 0
  if (left > window) left = window
  elapsed = (window - left) / window * 100
  gap = (used + 0) - elapsed
  phrase = ""
  if (gap >= 8) phrase = "▲ " label " ahead of pace"
  else if (gap <= -8) phrase = "▼ " label " under pace"
  if (phrase != "") {
    if (gap >= 8) phrase = paint(color_of(used + 0), phrase)
    else phrase = paint("32", phrase)
  }
  extra = ""
  if (label == "7d" && left >= 86400) {
    days = int(left / 86400)
    if (days < 1) days = 1
    per = (100 - (used + 0)) / (left / 86400)
    if (per < 0) per = 0
    per = int(per + 0.5)
    extra = sprintf("~%d%%/day left for %dd", per, days)
  }
  if (phrase != "" && extra != "") return phrase " · " extra
  if (phrase != "") return phrase
  return extra
}
function pace_seg() {
  if (val("pace") != "1") return ""
  return dot_join(pace_one("5h", val("five_pct"), val("five_reset"), 18000), pace_one("7d", val("seven_pct"), val("seven_reset"), 604800))
}
function vitals_seg(ms, added, removed, usd, comps, trend,    parts, text) {
  if (val("vitals") != "1") return ""
  parts = ""
  text = dur(ms)
  if (text != "" && text != "0s") parts = text
  if (comps ~ /^[0-9.]+$/ && (comps + 0) > 0) {
    text = sprintf("compact ×%d", int(comps + 0))
    parts = (parts == "" ? text : parts " · " text)
  }
  if (added != "" || removed != "") {
    text = line_counts(added, removed)
    parts = (parts == "" ? text : parts " · " text)
  }
  if (usd != "") {
    text = "$" money(usd)
    if (text != "$0") {
      if (!newfmt()) text = text trend
      parts = (parts == "" ? text : parts " · " text)
    }
  }
  if (parts == "") return ""
  # The emoji theme marks it with a stopwatch, so the word is not needed there.
  if (newfmt() && val("theme") == "emoji") return parts
  return "session " parts
}
function burn_pace(path, now, pct,    line, n, a, i, start, base_t, base_p, dt, dp, remain, eta, mins) {
  if (path == "" || pct == "") return ""
  n = 0
  while ((getline line < path) > 0) {
    n++
    split(line, a, " ")
    tt[n] = a[1] + 0
    pp[n] = a[2] + 0
  }
  close(path)
  base_t = 0
  start = n - 30
  if (start < 1) start = 1
  for (i = start; i <= n; i++) {
    if (now - tt[i] <= 1800 && now - tt[i] >= 30) {
      if (base_t == 0 || tt[i] < base_t) { base_t = tt[i]; base_p = pp[i] }
    }
  }
  if (base_t == 0) return ""
  dt = now - base_t
  dp = pct - base_p
  if (dp <= 0.05 || dt <= 0) return ""
  remain = 100 - pct
  if (remain <= 0) return ""
  eta = remain / (dp / dt)
  if (eta <= 0 || eta >= 86400) return ""
  mins = int(eta / 60 + 0.5)
  if (mins < 1) mins = 1
  if (mins >= 60) return sprintf("pace ~%dh%dm", int(mins / 60), mins % 60)
  return sprintf("pace ~%dm", mins)
}
# Display columns, not bytes. macOS awk counts bytes, so a bar cell (3 bytes)
# counted as 3 columns and the line was trimmed far too early. Drop UTF-8
# continuation bytes, and count 4-byte characters (emoji) as two columns.
function plain_len(s,    wide) {
  gsub(/\033\[[0-9;]*m/, "", s)
  gsub(/\033\]8;;[^\007]*\007/, "", s)
  if (length("\342\226\223") == 1) return length(s)
  wide = gsub(/[\360-\364]/, "&", s)
  gsub(/[\200-\277]/, "", s)
  return length(s) + wide
}
function push(pri, kind, text,    i) {
  if (text == "") return
  nseg++
  seg[nseg] = text
  pri_of[nseg] = pri
  kind_of[nseg] = kind
}
function reorder(    ord, n, i, j, m, key) {
  ord = val("order")
  if (ord == "") return
  n = split(ord, want, ",")
  m = 0
  for (i = 1; i <= n; i++) {
    key = want[i]
    gsub(/^[ \t]+|[ \t]+$/, "", key)
    for (j = 1; j <= nseg; j++) {
      if (taken[j]) continue
      if (kind_of[j] == key) {
        taken[j] = 1
        m++
        hold_s[m] = seg[j]
        hold_p[m] = pri_of[j]
      }
    }
  }
  for (j = 1; j <= nseg; j++) {
    if (taken[j]) continue
    m++
    hold_s[m] = seg[j]
    hold_p[m] = pri_of[j]
  }
  nseg = m
  for (i = 1; i <= m; i++) {
    seg[i] = hold_s[i]
    pri_of[i] = hold_p[i]
    drop[i] = 0
  }
}
function join_range(lo, hi,    i, out, count, sep) {
  out = ""
  count = 0
  sep = sep_of()
  for (i = lo; i <= hi; i++) {
    if (drop[i]) continue
    if (count == 0) out = seg[i]
    else out = out sep seg[i]
    count++
  }
  return out
}
function join_band(band,    i, out, count, sep) {
  out = ""
  count = 0
  sep = sep_of()
  for (i = 1; i <= nseg; i++) {
    if (drop[i]) continue
    if (band == 1 && pri_of[i] < 70) continue
    if (band == 2 && pri_of[i] >= 70) continue
    if (count == 0) out = seg[i]
    else out = out sep seg[i]
    count++
  }
  return out
}
# band 0 fits the whole single line. With two lines, each line (band 1 is
# priority >= 70, band 2 the rest) gets the full width on its own.
function fit(maxc, band,    total, i, best, best_i, guard) {
  if (maxc <= 0) return
  guard = 0
  while (guard < 40) {
    guard++
    total = plain_len(band == 0 ? join_range(1, nseg) : join_band(band))
    if (total <= maxc) return
    best = 999
    best_i = 0
    for (i = 1; i <= nseg; i++) {
      if (drop[i]) continue
      if (band == 1 && pri_of[i] < 70) continue
      if (band == 2 && pri_of[i] >= 70) continue
      if (pri_of[i] < best) { best = pri_of[i]; best_i = i }
    }
    if (best_i == 0) return
    drop[best_i] = 1
  }
}
{
  key = $1
  if (index($0, " ") > 0) v[key] = substr($0, index($0, " ") + 1)
  else v[key] = ""
}
END {
  nseg = 0
  split("model style ctx vitals cost git pr cache vim session dir project version tokens effort title app", sk, " ")
  for (i in sk) session_kinds[sk[i]] = 1
  model_text = val("model")
  if (val("sparkle") == "1") {
    if (model_text != "") model_text = "✨ " model_text
    else model_text = "✨"
  }
  push(100, "model", themed("model", model_text))
  push(25, "style", themed("style", val("style")))
  push(85, "ctx", themed("ctx", ctx_seg(val("ctx"), ctx_note(val("ctx"), val("ctx_size"), val("ctx_tokens"), val("compact_at"), val("auto_warn")))))
  if (val("show_five") == "1")
    push(90, "5h", themed("5h", window_seg("5h", val("five_pct"), val("five_reset"), val("five_abs"))))
  push(88, "spark", themed("spark", spark_seg("5h", val("spark5"), val("five_pct"))))
  if (val("show_seven") == "1")
    push(80, "7d", themed("7d", val("seven_pct") == "" ? val("seven_note") : window_seg("7d", val("seven_pct"), val("seven_reset"), val("seven_abs")) (val("seven_age") != "" ? " · " val("seven_age") : "")))
  push(78, "spark", themed("spark", spark_seg("7d", val("spark7"), val("seven_pct"))))
  push(72, "pace", themed("pace", pace_seg()))
  push(60, "spend", themed("spend", spend_seg(val("spend_pct"), val("spend_used"), val("spend_limit"))))
  push(30, "burn", burn_pace(val("hist"), val("now") + 0, val("five_pct")))
  if (val("vitals") == "1")
    push(50, "vitals", themed("vitals", vitals_seg(val("cost_ms"), val("lines_added"), val("lines_removed"), val("cost_usd"), val("compactions"), val("cost_trend"))))
  else
    push(50, "cost", themed("cost", cost_seg(val("cost_usd"), val("cost_ms"), val("lines_added"), val("lines_removed"))))
  push(40, "git", themed("git", val("git")))
  push(58, "fleet", themed("fleet", val("fleet")))
  push(56, "machines", themed("machines", val("machines")))
  push(57, "jobs", themed("jobs", val("jobs")))
  push(54, "grok", themed("grok", grok_seg(val("grok"))))
  push(20, "pr", themed("pr", val("pr")))
  push(15, "cache", themed("cache", val("cache")))
  push(10, "vim", themed("vim", val("vim")))
  push(45, "nudge", themed("nudge", val("nudge")))
  push(48, "value", themed("value", val("value")))
  push(5, "codex", themed("codex", codex_seg(val("codex5"), val("codex7"))))
  push(1, "session", themed("session", val("session")))
  push(95, "dir", themed("dir", val("dir")))
  push(35, "project", themed("project", val("project")))
  push(26, "effort", themed("effort", val("effort")))
  push(22, "tokens", themed("tokens", tokens_seg(val("in_tokens"), val("out_tokens"))))
  push(24, "title", themed("title", val("title")))
  push(3, "version", themed("version", val("version")))
  push(2, "app", themed("app", val("app")))
  reorder()
  if (val("lines") + 0 >= 5) {
    # Five lines: line 1 is this session only. Lines 2-5 come from lib/fivelines.py.
    for (i = 1; i <= nseg; i++)
      if (!(kind_of[i] in session_kinds)) drop[i] = 1
    fit(val("max_cols") + 0, 0)
    out = join_range(1, nseg)
    if (out != "") print out
  } else if (val("lines") + 0 >= 2) {
    fit(val("max_cols") + 0, 1)
    fit(val("max_cols") + 0, 2)
    line1 = join_band(1)
    line2 = join_band(2)
    if (line1 != "") print line1
    if (line2 != "") print line2
  } else {
    fit(val("max_cols") + 0, 0)
    out = join_range(1, nseg)
    if (out != "") print out
  }
}
'

if [[ "$LINES" -ge 5 ]]; then
