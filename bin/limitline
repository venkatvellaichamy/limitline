#!/usr/bin/env bash
# limitline — local usage-limit status line for Claude Code.
# Reads one JSON object on stdin. No network. Always exits 0.
# Version: 0.14.0

_here=${0%/*}
[[ "$_here" == "$0" ]] && _here="."
LIMITLINE_ROOT=$(cd "$_here/.." && pwd)

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat << 'EOF'
limitline — local usage limits for Claude Code and nearby CLIs

  bin/limitline < status.json
  bin/limitline status
  bin/limitline --host tmux|starship|prompt|json|swiftbar|cursor|codex
  bin/limitline preview|doctor|config|report|watch|theme|refresh [--force]
  bin/limitline set xai-plan PCT [--resets "YYYY-MM-DD HH:MM"] [--plan NAME]
  bin/limitline job update NAME --done N --total N --failed N --status running
  bin/limitline job list|rm NAME
  bin/limitline history [--days N] | report --week [--md]
  bin/limitline install-refresher|uninstall-refresher
  bin/limitline schedule install|uninstall|status

Config: ~/.config/limitline/config or config.toml
EOF
  exit 0
fi

case "${1:-}" in
  status|preview|doctor|config|report|watch|theme|refresh|install-refresher|uninstall-refresher|schedule|--host|set|job|history|version|--version|update|channel)
    if command -v python3 >/dev/null 2>&1; then
      exec python3 "$LIMITLINE_ROOT/lib/cli.py" "$@"
    fi
    exit 0
    ;;
esac

if [[ -t 0 ]]; then
  printf '%s\n' 'limitline reads a Claude Code status JSON object on stdin.' >&2
  exit 0
fi

input=$(cat || true)

debug_dump() {
  [[ "${LIMITLINE_DEBUG:-}" == "1" ]] || return 0
  local dest dir
  dest="${LIMITLINE_DEBUG_FILE:-}"
  if [[ -z "$dest" ]]; then
    dir="${XDG_CACHE_HOME:-$HOME/.cache}/limitline"
    mkdir -p "$dir" 2>/dev/null || return 0
    dest="$dir/stdin.json"
  else
    dir=${dest%/*}
    mkdir -p "$dir" 2>/dev/null || return 0
  fi
  printf '%s\n' "$input" > "$dest" 2>/dev/null || true
}

debug_dump

if [[ -z "${input//[[:space:]]/}" ]]; then
  exit 0
fi

BAR_WIDTH=5
CODEX_MODE=auto
COLOR_MODE=on
THEME=minimal
LINES=1
SEGMENTS=""
GIT_MODE=on
SESSION_MODE=off
BURN_MODE=on
LINKS_MODE=off
AUTO_AT=95
AUTO_WARN=80
PACE_MODE=""
SPARK_MODE=""
NUDGE_MODE=""
FRESH_MODE=""
VALUE_MODE=""
VITALS_MODE=""
ALERTS_MODE="off"
QUIET=""
PACE_SET=0
SPARK_SET=0
NUDGE_SET=0
FRESH_SET=0
VALUE_SET=0
VITALS_SET=0
FLEET_MODE=""
MACHINES_MODE=""
FLEET_SET=0
MACHINES_SET=0
FLEET_TTL=180
MACHINES_TTL=180
GROK_MODE=""
GROK_SET=0
GROK_TTL=180
JOBS_MODE=""
JOBS_SET=0
JOBS_TTL=180
SSH_TIMEOUT=2
MEM_WARN=15
HOSTS_RAW=""
ORDER_LIST=""
DIR_MODE=""
DIR_SET=0
DIR_STYLE=name
PROJECT_MODE=""
PROJECT_SET=0
PRESET=""
CFG_LINE1=""; CFG_LINE2=""; CFG_LINE3=""; CFG_LINE4=""; CFG_LINE5=""
CFG_LINE6=""; CFG_LINE7=""; CFG_LINE8=""; CFG_LINE9=""

trim() {
  local v="$1"
  v="${v#"${v%%[![:space:]]*}"}"
  v="${v%"${v##*[![:space:]]}"}"
  printf '%s' "$v"
}

load_config() {
  local cfg line key val
  if [[ -n "${LIMITLINE_CONFIG+x}" ]]; then
    cfg="$LIMITLINE_CONFIG"
  else
    local base="${XDG_CONFIG_HOME:-$HOME/.config}/limitline"
    if [[ -f "$base/config.toml" ]]; then
      cfg="$base/config.toml"
    else
      cfg="$base/config"
    fi
  fi
  [[ -f "$cfg" && -r "$cfg" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line=$(trim "$line")
    [[ -z "$line" || "$line" != *=* ]] && continue
    key=$(trim "${line%%=*}")
    key=$(printf '%s' "$key" | tr -d '[:space:]')
    val=$(trim "${line#*=}")
    case "$val" in
      \"*\") val="${val#\"}"; val="${val%\"}" ;;
      \'*\') val="${val#\'}"; val="${val%\'}" ;;
    esac
    case "$key" in
      bar_width) BAR_WIDTH="$val" ;;
      codex) CODEX_MODE="$val" ;;
      color|colour|colors|colours) COLOR_MODE="$val" ;;
      theme) THEME="$val" ;;
      lines) LINES="$val" ;;
      segments) SEGMENTS="$val" ;;
      git) GIT_MODE="$val" ;;
      session) SESSION_MODE="$val" ;;
      burn) BURN_MODE="$val" ;;
      links) LINKS_MODE="$val" ;;
      auto_compact) AUTO_AT="$val" ;;
      auto_compact_warn) AUTO_WARN="$val" ;;
      pace) PACE_MODE="$val"; PACE_SET=1 ;;
      spark|sparklines) SPARK_MODE="$val"; SPARK_SET=1 ;;
      nudges|nudge) NUDGE_MODE="$val"; NUDGE_SET=1 ;;
      fresh) FRESH_MODE="$val"; FRESH_SET=1 ;;
      value) VALUE_MODE="$val"; VALUE_SET=1 ;;
      vitals) VITALS_MODE="$val"; VITALS_SET=1 ;;
      alerts) ALERTS_MODE="$val" ;;
      quiet|quiet_hours) QUIET="$val" ;;
      fleet) FLEET_MODE="$val"; FLEET_SET=1 ;;
      machines) MACHINES_MODE="$val"; MACHINES_SET=1 ;;
      hosts) HOSTS_RAW="$val" ;;
      ssh_timeout) SSH_TIMEOUT="$val" ;;
      mem_free_warn) MEM_WARN="$val" ;;
      fleet_ttl) FLEET_TTL="$val" ;;
      machines_ttl) MACHINES_TTL="$val" ;;
      grok) GROK_MODE="$val"; GROK_SET=1 ;;
      grok_ttl) GROK_TTL="$val" ;;
      jobs) JOBS_MODE="$val"; JOBS_SET=1 ;;
      jobs_detail) JOBS_DETAIL="$val" ;;
      jobs_ttl) JOBS_TTL="$val" ;;
      marks) MARKS_MODE="$val" ;;
      animate) ANIMATE_MODE="$val" ;;
      plan_view) PLAN_VIEW="$val" ;;
      plan_numbers) PLAN_NUMBERS="$val" ;;
      plan_show) PLAN_SHOW="$val" ;;
      plan_resets) PLAN_RESETS="$val" ;;
      dir|folder) DIR_MODE="$val"; DIR_SET=1 ;;
      dir_style) DIR_STYLE="$val" ;;
      project) PROJECT_MODE="$val"; PROJECT_SET=1 ;;
      preset) PRESET="$val" ;;
      line[1-9]) printf -v "CFG_LINE${key#line}" '%s' "$val" ;;
    esac
  done < "$cfg"
}

load_config

if [[ -n "${LIMITLINE_BAR_WIDTH:-}" ]]; then
  BAR_WIDTH="$LIMITLINE_BAR_WIDTH"
fi
case "${LIMITLINE_CODEX:-}" in
  "") ;;
  0|off|false|no) CODEX_MODE=off ;;
  1|on|true|yes) CODEX_MODE=on ;;
  auto) CODEX_MODE=auto ;;
esac
if [[ -n "${NO_COLOR+x}" && -n "${NO_COLOR}" ]] || [[ "${COLOR_MODE}" == "off" || "${COLOR_MODE}" == "0" || "${COLOR_MODE}" == "false" ]]; then
  COLOR_MODE=off
fi
case "$BAR_WIDTH" in
  ''|*[!0-9]*) BAR_WIDTH=5 ;;
esac
if [[ "$BAR_WIDTH" -lt 1 ]]; then BAR_WIDTH=1; fi
if [[ "$BAR_WIDTH" -gt 40 ]]; then BAR_WIDTH=40; fi

USE_COLOR=1
[[ "$COLOR_MODE" == "off" ]] && USE_COLOR=0

CODEX_ENABLED=1
case "$CODEX_MODE" in
  off|0|false|no) CODEX_ENABLED=0 ;;
esac

if [[ -n "${LIMITLINE_THEME:-}" ]]; then THEME="$LIMITLINE_THEME"; fi
if [[ "${LIMITLINE_ASCII:-}" == "1" ]]; then THEME=ascii; fi
if [[ -n "${LIMITLINE_LINES:-}" ]]; then LINES="$LIMITLINE_LINES"; fi
if [[ -n "${LIMITLINE_SEGMENTS:-}" ]]; then SEGMENTS="$LIMITLINE_SEGMENTS"; fi
if [[ -n "${LIMITLINE_GIT:-}" ]]; then GIT_MODE="$LIMITLINE_GIT"; fi
if [[ -n "${LIMITLINE_SESSION:-}" ]]; then SESSION_MODE="$LIMITLINE_SESSION"; fi
if [[ -n "${LIMITLINE_BURN:-}" ]]; then BURN_MODE="$LIMITLINE_BURN"; fi
if [[ -n "${LIMITLINE_LINKS:-}" ]]; then LINKS_MODE="$LIMITLINE_LINKS"; fi
if [[ -n "${LIMITLINE_AUTO_COMPACT:-}" ]]; then AUTO_AT="$LIMITLINE_AUTO_COMPACT"; fi
if [[ -n "${LIMITLINE_AUTO_COMPACT_WARN:-}" ]]; then AUTO_WARN="$LIMITLINE_AUTO_COMPACT_WARN"; fi
if [[ -n "${LIMITLINE_PACE:-}" ]]; then PACE_MODE="$LIMITLINE_PACE"; PACE_SET=1; fi
if [[ -n "${LIMITLINE_SPARK:-}" ]]; then SPARK_MODE="$LIMITLINE_SPARK"; SPARK_SET=1; fi
if [[ -n "${LIMITLINE_NUDGES:-}" ]]; then NUDGE_MODE="$LIMITLINE_NUDGES"; NUDGE_SET=1; fi
if [[ -n "${LIMITLINE_FRESH:-}" ]]; then FRESH_MODE="$LIMITLINE_FRESH"; FRESH_SET=1; fi
if [[ -n "${LIMITLINE_VALUE:-}" ]]; then VALUE_MODE="$LIMITLINE_VALUE"; VALUE_SET=1; fi
if [[ -n "${LIMITLINE_VITALS:-}" ]]; then VITALS_MODE="$LIMITLINE_VITALS"; VITALS_SET=1; fi
if [[ -n "${LIMITLINE_ALERTS:-}" ]]; then ALERTS_MODE="$LIMITLINE_ALERTS"; fi
if [[ -n "${LIMITLINE_QUIET:-}" ]]; then QUIET="$LIMITLINE_QUIET"; fi
if [[ -n "${LIMITLINE_FLEET:-}" ]]; then FLEET_MODE="$LIMITLINE_FLEET"; FLEET_SET=1; fi
if [[ -n "${LIMITLINE_MACHINES:-}" ]]; then MACHINES_MODE="$LIMITLINE_MACHINES"; MACHINES_SET=1; fi
if [[ -n "${LIMITLINE_FLEET_TTL:-}" ]]; then FLEET_TTL="$LIMITLINE_FLEET_TTL"; fi
if [[ -n "${LIMITLINE_MACHINES_TTL:-}" ]]; then MACHINES_TTL="$LIMITLINE_MACHINES_TTL"; fi
if [[ -n "${LIMITLINE_GROK:-}" ]]; then GROK_MODE="$LIMITLINE_GROK"; GROK_SET=1; fi
if [[ -n "${LIMITLINE_GROK_TTL:-}" ]]; then GROK_TTL="$LIMITLINE_GROK_TTL"; fi
if [[ -n "${LIMITLINE_JOBS:-}" ]]; then JOBS_MODE="$LIMITLINE_JOBS"; JOBS_SET=1; fi
if [[ -n "${LIMITLINE_JOBS_TTL:-}" ]]; then JOBS_TTL="$LIMITLINE_JOBS_TTL"; fi
if [[ -n "${LIMITLINE_DIR:-}" ]]; then DIR_MODE="$LIMITLINE_DIR"; DIR_SET=1; fi
if [[ -n "${LIMITLINE_DIR_STYLE:-}" ]]; then DIR_STYLE="$LIMITLINE_DIR_STYLE"; fi
if [[ -n "${LIMITLINE_PROJECT:-}" ]]; then PROJECT_MODE="$LIMITLINE_PROJECT"; PROJECT_SET=1; fi
if [[ -n "${LIMITLINE_SSH_TIMEOUT:-}" ]]; then SSH_TIMEOUT="$LIMITLINE_SSH_TIMEOUT"; fi
if [[ -n "${LIMITLINE_MEM_WARN:-}" ]]; then MEM_WARN="$LIMITLINE_MEM_WARN"; fi
if [[ -z "${LIMITLINE_HOSTS+x}" && -n "$HOSTS_RAW" ]]; then
  HOSTS_RAW=$(printf '%s' "$HOSTS_RAW" | tr -d '[]' | tr -d '"' | tr -d "'")
  export LIMITLINE_HOSTS="$HOSTS_RAW"
fi
if [[ -n "${LIMITLINE_SSH_TIMEOUT:-$SSH_TIMEOUT}" ]]; then
  export LIMITLINE_SSH_TIMEOUT="${LIMITLINE_SSH_TIMEOUT:-$SSH_TIMEOUT}"
fi
if [[ -n "${LIMITLINE_MEM_WARN:-$MEM_WARN}" ]]; then
  export LIMITLINE_MEM_WARN="${LIMITLINE_MEM_WARN:-$MEM_WARN}"
fi
case "$LINES" in ''|*[!0-9]*) LINES=1 ;; esac
if [[ "$LINES" -lt 1 ]]; then LINES=1; fi
if [[ "$LINES" -gt 2 && "$LINES" -lt 5 ]]; then LINES=2; fi
if [[ "$LINES" -gt 5 ]]; then LINES=5; fi
case "$AUTO_AT" in ''|*[!0-9]*) AUTO_AT=95 ;; esac
case "$AUTO_WARN" in ''|*[!0-9]*) AUTO_WARN=80 ;; esac

flag_on() {
  case "$1" in
    1|on|true|yes) return 0 ;;
    *) return 1 ;;
  esac
}

ON_MODEL=1; ON_STYLE=1; ON_CTX=1; ON_FIVE=1; ON_SEVEN=1; ON_SPEND=1
ON_BURN=1; ON_COST=1; ON_GIT=1; ON_PR=1; ON_CACHE=1; ON_VIM=1
ON_SESSION=0; ON_CODEX=1
ON_PACE=0; ON_SPARK=0; ON_NUDGE=0; ON_FRESH=0; ON_VALUE=0; ON_VITALS=0
ON_FLEET=0; ON_MACHINES=0; ON_GROK=0; ON_JOBS=1
ON_DIR=1; ON_PROJECT=1; ON_VERSION=0; ON_TOKENS=0; ON_EFFORT=0; ON_TITLE=0; ON_APP=0
add_order() {
  case ",$ORDER_LIST," in
    *,"$1",*) ;;
    *) ORDER_LIST="${ORDER_LIST:+$ORDER_LIST,}$1" ;;
  esac
}
segments_off() {
  ON_MODEL=0; ON_STYLE=0; ON_CTX=0; ON_FIVE=0; ON_SEVEN=0; ON_SPEND=0
  ON_BURN=0; ON_COST=0; ON_GIT=0; ON_PR=0; ON_CACHE=0; ON_VIM=0
  ON_SESSION=0; ON_CODEX=0
  ON_PACE=0; ON_SPARK=0; ON_NUDGE=0; ON_FRESH=0; ON_VALUE=0; ON_VITALS=0
  ON_FLEET=0; ON_MACHINES=0; ON_GROK=0; ON_JOBS=0
  ON_DIR=0; ON_PROJECT=0; ON_VERSION=0; ON_TOKENS=0; ON_EFFORT=0; ON_TITLE=0; ON_APP=0
}
seg_add() { SEG_IDS="${SEG_IDS:+$SEG_IDS,}$1"; }
# One segment id (a limitline id or a Codex /statusline item id): turn it on and add
# the limitline ids it stands for to SEG_IDS. Unknown ids add nothing.
segment_on() {
  case "$1" in
    model) ON_MODEL=1; seg_add model ;;
    model-with-reasoning) ON_MODEL=1; ON_EFFORT=1; seg_add model; seg_add effort ;;
    effort|reasoning) ON_EFFORT=1; seg_add effort ;;
    style) ON_STYLE=1; seg_add style ;;
    context|ctx|context-remaining|context-used|context-window-size) ON_CTX=1; seg_add ctx ;;
    5h|five-hour-limit) ON_FIVE=1; seg_add 5h ;;
    7d|weekly-limit) ON_SEVEN=1; seg_add 7d ;;
    spend) ON_SPEND=1; seg_add spend ;;
    limits) ON_FIVE=1; ON_SEVEN=1; ON_SPEND=1; seg_add 5h; seg_add 7d; seg_add spend ;;
    burn) ON_BURN=1; seg_add burn ;;
    cost|estimated-thread-cost) ON_COST=1; seg_add cost ;;
    git|git-branch) ON_GIT=1; seg_add git ;;
    pr) ON_PR=1; seg_add pr ;;
    cache) ON_CACHE=1; seg_add cache ;;
    vim) ON_VIM=1; seg_add vim ;;
    session|session-id) ON_SESSION=1; seg_add session ;;
    codex|others) ON_CODEX=1; seg_add codex ;;
    pace) ON_PACE=1; seg_add pace ;;
    spark|sparklines) ON_SPARK=1; seg_add spark ;;
    nudge|nudges) ON_NUDGE=1; seg_add nudge ;;
    fresh) ON_FRESH=1 ;;
    value) ON_VALUE=1; seg_add value ;;
    vitals) ON_VITALS=1; seg_add vitals ;;
    fleet) ON_FLEET=1; seg_add fleet ;;
    machines) ON_MACHINES=1; seg_add machines ;;
    grok|xai|xai-plan|cursor+grok|plan) ON_GROK=1; seg_add grok ;;
    jobs) ON_JOBS=1; seg_add jobs ;;
    dir|current-dir|folder) ON_DIR=1; seg_add dir ;;
    project|project-name) ON_PROJECT=1; seg_add project ;;
    version|codex-version) ON_VERSION=1; seg_add version ;;
    tokens|used-tokens|total-input-tokens|total-output-tokens) ON_TOKENS=1; seg_add tokens ;;
    title|thread-title) ON_TITLE=1; seg_add title ;;
    app|app-name) ON_APP=1; seg_add app ;;
  esac
}
# Turn on every id in a comma list; SEG_IDS gets the limitline ids, in order.
segment_ids() {
  local raw name old_ifs=$IFS
  SEG_IDS=""
  IFS=','
  for raw in $1; do
    name="${raw//[\[\]\"\'[:space:]]/}"
    [[ -n "$name" ]] && segment_on "$name"
  done
  IFS=$old_ifs
}
# 0.15 changed line 1's default order and wording. A config that names its own
# `segments` keeps 0.14's order and wording exactly.
FMT=new
if [[ -n "$SEGMENTS" ]]; then
  FMT=old
  segments_off
  segment_ids "$SEGMENTS"
  old_ifs=$IFS
  IFS=','
  for id in $SEG_IDS; do add_order "$id"; done
  IFS=$old_ifs
else
  ORDER_LIST="dir,project,git,model,effort,ctx"
fi
if [[ "$DIR_SET" == "1" ]]; then flag_on "$DIR_MODE" || ON_DIR=0; fi
if [[ "$PROJECT_SET" == "1" ]]; then flag_on "$PROJECT_MODE" || ON_PROJECT=0; fi
flag_on "$GIT_MODE" || ON_GIT=0
flag_on "$SESSION_MODE" && ON_SESSION=1
flag_on "$BURN_MODE" || ON_BURN=0
flag_on "$LINKS_MODE" && LINKS=1 || LINKS=0
if [[ "$PACE_SET" == "1" ]]; then flag_on "$PACE_MODE" && ON_PACE=1 || ON_PACE=0; fi
if [[ "$SPARK_SET" == "1" ]]; then flag_on "$SPARK_MODE" && ON_SPARK=1 || ON_SPARK=0; fi
if [[ "$NUDGE_SET" == "1" ]]; then flag_on "$NUDGE_MODE" && ON_NUDGE=1 || ON_NUDGE=0; fi
if [[ "$FRESH_SET" == "1" ]]; then flag_on "$FRESH_MODE" && ON_FRESH=1 || ON_FRESH=0; fi
if [[ "$VALUE_SET" == "1" ]]; then flag_on "$VALUE_MODE" && ON_VALUE=1 || ON_VALUE=0; fi
if [[ "$VITALS_SET" == "1" ]]; then flag_on "$VITALS_MODE" && ON_VITALS=1 || ON_VITALS=0; fi
if [[ "$FLEET_SET" == "1" ]]; then flag_on "$FLEET_MODE" && ON_FLEET=1 || ON_FLEET=0; fi
if [[ "$MACHINES_SET" == "1" ]]; then flag_on "$MACHINES_MODE" && ON_MACHINES=1 || ON_MACHINES=0; fi
if [[ "$GROK_SET" == "1" ]]; then flag_on "$GROK_MODE" && ON_GROK=1 || ON_GROK=0; fi
if [[ "$JOBS_SET" == "1" ]]; then flag_on "$JOBS_MODE" && ON_JOBS=1 || ON_JOBS=0; fi
case "$JOBS_TTL" in ''|*[!0-9]*) JOBS_TTL=180 ;; esac
case "$FLEET_TTL" in ''|*[!0-9]*) FLEET_TTL=60 ;; esac
case "$GROK_TTL" in ''|*[!0-9]*) GROK_TTL=180 ;; esac
case "$MACHINES_TTL" in ''|*[!0-9]*) MACHINES_TTL=60 ;; esac
case "$ALERTS_MODE" in
  bell|notify|test|osascript) ;;
  *) ALERTS_MODE=off ;;
esac
flag_on "$SESSION_MODE" || true

NOW="${LIMITLINE_NOW:-$(date +%s)}"
case "$NOW" in
  ''|*[!0-9]*) NOW=$(date +%s) ;;
esac

model=""
