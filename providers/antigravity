#!/usr/bin/env python3
"""Antigravity (agy) usage from the cache `limitline refresh` writes. See lib/antigravity.py."""
import json, os, sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))


def main():
    import antigravity
    data = antigravity.read()
    json.dump(data, sys.stdout, sort_keys=True, separators=(",", ":"))
    sys.stdout.write("\n")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
