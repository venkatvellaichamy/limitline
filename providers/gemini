#!/usr/bin/env python3
"""The Gemini app allowance (gemini.google.com and the Mac app). Not measured.

Google AI Pro has two allowances. The Antigravity one (agy CLI and IDE) is
live in providers/antigravity. The Gemini app's "Current usage" and "Weekly
limit" appear only at https://gemini.google.com/usage: no CLI command or plain
local file exposes them, and limitline never reads cookies, keychains, token
stores, or LevelDB/IndexedDB blobs. So this row has no window and never a
guessed number.
"""
import json, sys

NOTE = "not measured (see gemini.google.com/usage)"


def main():
    json.dump({"note": NOTE, "observed_at": None, "provider": "gemini", "source": "none",
               "stale": False, "windows": []}, sys.stdout, sort_keys=True, separators=(",", ":"))
    sys.stdout.write("\n")


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
