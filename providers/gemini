#!/usr/bin/env python3
"""Last exhausted-quota line in the Antigravity CLI log. No other quota cache exists."""
import json, os, re, sys, time
from datetime import datetime, timezone

def emit(obj):
    json.dump(obj, sys.stdout, sort_keys=True, separators=(",", ":"))
    sys.stdout.write("\n")

STAMP = re.compile(r"^[IWEF](\d{2})(\d{2})\s+(\d{2}):(\d{2}):(\d{2})")
RESET = re.compile(r"Resets in (?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?", re.I)

def stamp_epoch(line, now):
    match = STAMP.match(line)
    if not match:
        return None
    month, day, hour, minute, second = (int(part) for part in match.groups())
    year = datetime.fromtimestamp(now, timezone.utc).year
    try:
        candidate = datetime(year, month, day, hour, minute, second, tzinfo=timezone.utc).timestamp()
    except ValueError:
        return None
    if candidate - now > 2 * 86400:
        try:
            candidate = datetime(year - 1, month, day, hour, minute, second, tzinfo=timezone.utc).timestamp()
        except ValueError:
            return None
    return int(candidate)

def duration_seconds(line):
    match = RESET.search(line)
    if not match:
        return None
    hours = int(match.group(1) or 0)
    minutes = int(match.group(2) or 0)
    seconds = int(match.group(3) or 0)
    total = hours * 3600 + minutes * 60 + seconds
    return total or None

def main():
    now = int(os.environ.get("LIMITLINE_NOW") or time.time())
    path = os.environ.get("LIMITLINE_GEMINI_LOG") or os.path.join(
        os.path.expanduser("~"), ".gemini", "antigravity-cli", "cli.log"
    )
    empty = {"observed_at": None, "provider": "gemini", "source": "none", "stale": False, "windows": []}
    if not os.path.isfile(path):
        emit(empty)
        return
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as fh:
            if size > 2000000:
                fh.seek(size - 2000000)
                fh.readline()
            text = fh.read().decode("utf-8", "replace")
    except OSError:
        emit(empty)
        return
    found = None
    for line in text.splitlines():
        if "quota reached" in line.lower() and "Resets in" in line:
            found = line
    if not found:
        emit(empty)
        return
    observed = stamp_epoch(found, now)
    span = duration_seconds(found)
    if observed is None or span is None:
        emit(empty)
        return
    resets = observed + span
    stale = now > resets
    emit({
        "observed_at": observed,
        "provider": "gemini",
        "source": "cli.log",
        "stale": stale,
        "windows": [{"name": "quota", "resets_at": resets, "used_pct": 100}],
    })

if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
